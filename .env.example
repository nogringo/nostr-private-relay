# Host port to expose the relay on
PORT=3334

# Public URL of the relay, e.g. wss://private.example.com/ (required for NIP-42 Auth challenge)
RELAY_URL=wss://private.example.com

# Name of the relay (NIP-11 metadata)
RELAY_NAME=Private relay

# Description of the relay (NIP-11 metadata)
RELAY_DESCRIPTION=A private relay where only the author can read their own events.

# Optional icon URL exposed in NIP-11 metadata
# RELAY_ICON=https://example.com/icon.png

# Optional contact information exposed in NIP-11 metadata
# RELAY_CONTACT=npub...

# Hex-encoded public key of the relay owner (only this user can post/read)
# RELAY_PUBKEY=

# Maximum query limit for subscription filters (default: 500)
RELAY_MAX_LIMIT=500
